# Backend Environment Variables

# FastAPI Configuration
FASTAPI_ENV=development
API_PORT=8000
API_HOST=0.0.0.0

# CORS Configuration
ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=INFO

# Debug Mode
DEBUG=true

# ============ JWT Token Configuration ============
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_EXPIRY_HOURS=24

# ============ Google Sheets Configuration ============
# Get this JSON from Google Cloud Console -> Service Accounts
# Copy the entire JSON key here (single line, no newlines)
GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "your-project-id", ...}

# Google Sheet ID (from the URL of your Google Sheet)
# Example: https://docs.google.com/spreadsheets/d/1ABC123xyz/edit
# Sheet ID is: 1ABC123xyz
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
